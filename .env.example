# Provider Mesh — configuration NAMES only (Foundation 001 §5.3, A19; SEC-PLAT-03).
# Values are held in Replit Secrets (development) or CI secrets; this file never carries one.
# The application reads ONLY these Springboard-named variables. Platform-injected database
# variables are never read (ADR-001 §6.3 rule 8).

# Instance identity — must match mesh_instance in both databases (§5.3 rule 3)
PROVIDER_MESH_INSTANCE_ID=
PROVIDER_MESH_ENVIRONMENT=

# Application runtime (mesh_app → provider_mesh); the only database variable the app reads (§5.3 rule 1)
PROVIDER_MESH_DATABASE_URL=

# Audit Service (mesh_audit_writer → provider_mesh_audit) (§5.5)
PROVIDER_MESH_AUDIT_URL=

# Migration mechanism only — never the running application (§5.2, §5.4)
PROVIDER_MESH_MIGRATE_URL=
PROVIDER_MESH_AUDIT_MIGRATE_URL=

# audit:verify (mesh_audit_reader) (§5.5 rule 3)
PROVIDER_MESH_AUDIT_READER_URL=

# HTTP port supplied by the platform (§5.10); defaults to 3000 when absent
PORT=
